# MongoDB Configuration
# If MONGODB_URI is set, the app will use MongoDB via Vercel serverless functions.
# Otherwise, it automatically falls back to browser localStorage with demo data.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=svit_college

# Frontend env (Vite) — expose MongoDB usage flag to client
# Set to "true" if you have configured MongoDB on the server
VITE_USE_MONGODB=false
# Alternative: set VITE_MONGODB_URI or VITE_API_URL to enable API mode
# VITE_API_URL=https://your-deployment.vercel.app
# VITE_MONGODB_URI=mongodb+srv://...

# Optional: Supabase (currently unused, reserved for future auth)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
